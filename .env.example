# Embudo (demo): todas las variables, con valores falsos. Los valores reales van en .env.local (lo completa Germán).
# Ver qué falta sin mostrar valores: npm run check-env

# Gemini (aistudio.google.com → Get API key). Calificación de leads con structured output.
GEMINI_API_KEY=pon-aca-tu-clave
GEMINI_MODEL=gemini-3.5-flash-lite

# HubSpot: cuenta gratuita + developer test account → Settings → Integrations → Private Apps (scopes de CRM: contacts, companies, deals, tasks).
HUBSPOT_PRIVATE_APP_TOKEN=pon-aca-el-token-de-la-private-app

# Slack: api.slack.com/apps → tu app → OAuth (chat:write) y Basic Information (signing secret).
SLACK_BOT_TOKEN=pon-aca-el-token-del-bot
SLACK_SIGNING_SECRET=pon-aca-el-signing-secret
SLACK_CANAL_LEADS=C0000000000

# n8n Cloud (Settings → n8n API): la API key solo la usan los scripts de despliegue; el token del webhook es nuevo y solo de este proyecto.
N8N_BASE_URL=https://tu-instancia.app.n8n.cloud
N8N_API_KEY=pon-aca-la-api-key-de-n8n
N8N_WEBHOOK_TOKEN=genera-uno-nuevo-solo-para-embudo

# Google Sheets (log de leads para el reporte): id de la planilla de la demo.
SHEETS_LOG_ID=pon-aca-el-id-de-la-planilla

# URL del webhook de producción del workflow "Embudo - Leads" en n8n (vacía = el formulario procesa en modo local).
N8N_WEBHOOK_URL=
